+#ifdef TW_REQUIRE_CRYPTO_BOOT_PARAMS
+// KeyMint 将原 Android 的 OS/patch 参数绑定到现有 keyblob；不能用恢复系统默认值试升级。
+static bool IsInstalledAndroidRelease(const std::string& value) {
+	return !value.empty() && value.front() >= '1' && value.front() <= '9' &&
+		value.back() != '.' && value.find("..") == std::string::npos &&
+		value.find_first_not_of("0123456789.") == std::string::npos;
+}
+
+static bool IsInstalledAndroidPatch(const std::string& value) {
+	if (value.size() != 10 || value[4] != '-' || value[7] != '-')
+		return false;
+	for (size_t i = 0; i < value.size(); ++i) {
+		if (i != 4 && i != 7 && (value[i] < '0' || value[i] > '9'))
+			return false;
+	}
+	int year, month, day;
+	return std::sscanf(value.c_str(), "%4d-%2d-%2d", &year, &month, &day) == 3 &&
+		year >= 1970 && month >= 1 && month <= 12 && day >= 1 && day <= 31;
+}
+
+static bool PrepareInstalledAndroidCryptoParams(TWPartition* vendor, TWPartition* system) {
+	const bool vendor_was_mounted = vendor && vendor->Is_Mounted();
+	const bool system_was_mounted = system && system->Is_Mounted();
+	bool prepared = false;
+	do {
+		// 只从实际系统分区读取；没有 /system_root 时不绑定 recovery 的 /system 冒充原系统。
+		if (!vendor || !system || !vendor->Mount(false) || !system->Mount(false)) {
+			LOGERR("FBE: original system/vendor unavailable; crypto parameters not prepared.\n");
+			break;
+		}
+		const std::string release = TWFunc::Partition_Property_Get(
+			"ro.build.version.release", PartitionManager, "/system_root", "build.prop");
+		const std::string system_patch = TWFunc::Partition_Property_Get(
+			"ro.build.version.security_patch", PartitionManager, "/system_root", "build.prop");
+		const std::string vendor_patch = TWFunc::Partition_Property_Get(
+			"ro.vendor.build.security_patch", PartitionManager, "/vendor", "build.prop");
+		if (!IsInstalledAndroidRelease(release) || !IsInstalledAndroidPatch(system_patch) ||
+			!IsInstalledAndroidPatch(vendor_patch)) {
+			LOGERR("FBE: original Android version/patch properties missing or invalid.\n");
+			break;
+		}
+		// O1 Configure 使用 OS version/patch；vendor patch 仅保留真实属性供其消费者读取。
+		const std::string recovery_release = android::base::GetProperty("ro.build.version.release", "");
+		android::base::SetProperty("twrp.crypto.recovery_release", recovery_release);
+		ResetProp("ro.build.version.release", release);
+		ResetProp("ro.build.version.security_patch", system_patch);
+		ResetProp("ro.vendor.build.security_patch", vendor_patch);
+		if (android::base::GetProperty("ro.build.version.release", "") != release ||
+			android::base::GetProperty("ro.build.version.security_patch", "") != system_patch ||
+			android::base::GetProperty("ro.vendor.build.security_patch", "") != vendor_patch) {
+			LOGERR("FBE: installed Android crypto parameter readback failed.\n");
+			break;
+		}
+		android::base::SetProperty("twrp.crypto.android_release", release);
+		LOGINFO("FBE: installed Android %s OS patch %s vendor property %s; recovery base %s.\n",
+			release.c_str(), system_patch.c_str(), vendor_patch.c_str(), recovery_release.c_str());
+		prepared = true;
+	} while (false);
+
+	// 所有路径都恢复本函数新建的挂载，让随后 prebuilt 加载能看到 ramdisk 模块目录。
+	// 不卸载进入时已挂载的分区；清理失败也不得向 init 发布参数 ready。
+	bool cleanup_ok = true;
+	if (system && !system_was_mounted && system->Is_Mounted()) {
+		if (!system->UnMount(false) || system->Is_Mounted()) {
+			LOGERR("FBE: cannot restore original system mount state; crypto parameters not ready.\n");
+			cleanup_ok = false;
+		}
+	}
+	if (vendor && !vendor_was_mounted && vendor->Is_Mounted()) {
+		if (!vendor->UnMount(false) || vendor->Is_Mounted()) {
+			LOGERR("FBE: cannot restore original vendor mount state; crypto parameters not ready.\n");
+			cleanup_ok = false;
+		}
+	}
+	return prepared && cleanup_ok;
+}
+#endif
 #endif
 
