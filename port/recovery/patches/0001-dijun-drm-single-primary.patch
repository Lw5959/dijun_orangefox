+#ifdef TW_DRM_SINGLE_PLANE
+// DRM 枚举顺序不能表达用途；只选择可连接到当前 CRTC、支持实际 FB 格式的 primary。
+static drmModePlane* find_primary_plane(drmModePlaneRes* options, uint32_t crtc_mask,
+                                       uint32_t format) {
+  for (uint32_t i = 0; i < options->count_planes; ++i) {
+    drmModePlane* plane = drmModeGetPlane(drm_fd, options->planes[i]);
+    if (!plane) continue;
+    bool compatible = (plane->possible_crtcs & crtc_mask) != 0;
+    bool supports_format = false;
+    for (uint32_t j = 0; j < plane->count_formats; ++j)
+      if (plane->formats[j] == format) supports_format = true;
+    bool primary = false;
+    drmModeObjectProperties* props = drmModeObjectGetProperties(
+        drm_fd, plane->plane_id, DRM_MODE_OBJECT_PLANE);
+    if (props) {
+      for (uint32_t j = 0; j < props->count_props; ++j) {
+        drmModePropertyRes* prop = drmModeGetProperty(drm_fd, props->props[j]);
+        if (!prop) continue;
+        if (!strcmp(prop->name, "type") && props->prop_values[j] == DRM_PLANE_TYPE_PRIMARY)
+          primary = true;
+        drmModeFreeProperty(prop);
+      }
+      drmModeFreeObjectProperties(props);
+    }
+    if (compatible && supports_format && primary) {
+      printf("DRM single primary plane=%u crtc_mask=%u format=%08x\n",
+             plane->plane_id, crtc_mask, format);
+      return plane;
+    }
+    drmModeFreePlane(plane);
+  }
+  printf("DRM: no compatible primary plane for current CRTC/format\n");
+  return nullptr;
+}
+#endif
