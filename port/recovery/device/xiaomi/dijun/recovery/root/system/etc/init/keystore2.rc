# 服务定义保留 OrangeFox 原生 etc/init/keystore2.rc 的路径、参数、UID/GID 和 domain。
# 先读取真实已装 Android 的绑定参数，再启动 keystore2，防止缓存 recovery 的默认版本。
on property:twrp.modules.loaded=true && property:twrp.crypto.boot_params.ready=true
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
    disabled
